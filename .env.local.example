# Public API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

NEXT_PUBLIC_APP_TIMEZONE=Asia/Colombo
NEXT_PUBLIC_USER_APP_URL=http://localhost:3000

# Cloudflare Turnstile (guest help ticket + register forms)
# Site key is public; secret belongs in ITrustLD_Backend/.env as TURNSTILE_SECRET_KEY
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAABgpWO1byq2Cgv3v

# Tidio live chat (members only — same key as Laravel footer-customer)
# NEXT_PUBLIC_TIDIO_KEY=e3tkzblgnc6o2jkryjhomfcotdsnyybp
